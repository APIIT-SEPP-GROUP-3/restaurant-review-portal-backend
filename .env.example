# =========================
# Application
# =========================
PORT=5001


# =========================
# Database
# =========================

# Local development example:
# postgresql://username:password@localhost:5432/restaurant_review_portal?schema=public
#
# Docker example:
# postgresql://dinerate:password@postgres:5432/restaurant_review_portal?schema=public

DATABASE_URL=

POSTGRES_DB=restaurant_review_portal
POSTGRES_USER=dinerate
POSTGRES_PASSWORD=


# =========================
# Authentication
# =========================
JWT_SECRET=


# =========================
# Cloudflare R2
# =========================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dinerate-bucket
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=https://images.dinerate.xyz
# Dedicated disposable test database: name must end in _test.
# Set in .env.test or export; never reuse DATABASE_URL.
TEST_DATABASE_URL=
